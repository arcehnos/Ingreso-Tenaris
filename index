    <!-- JS PARA PERSISTENCIA DE CHECKLIST EN MEMORIA DE NAVEGADOR -->
    
<script>
    const STORAGE_KEY = 'arce_tenaris_checklist_v6';

    function updateProgress() {
        const checkboxes = document.querySelectorAll('.check-card input[type="checkbox"]');
        const total = checkboxes.length;
        let checkedCount = 0;
        const state = [];

        checkboxes.forEach((cb) => {
            if (cb.checked) checkedCount++;
            state.push(cb.checked);

            const card = cb.closest('.check-card');
            if (card) card.classList.toggle('checked', cb.checked);
        });

        const percentage = total ? Math.round((checkedCount / total) * 100) : 0;
        const percentageEl = document.getElementById('check-percentage');
        const fillEl = document.getElementById('progress-fill');

        if (percentageEl) percentageEl.innerText = percentage + '% Completado';
        if (fillEl) fillEl.style.width = percentage + '%';

        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    function loadProgress() {
        try {
            const savedState = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
            const checkboxes = document.querySelectorAll('.check-card input[type="checkbox"]');

            if (Array.isArray(savedState)) {
                checkboxes.forEach((cb, index) => {
                    cb.checked = Boolean(savedState[index]);
                });
            }
        } catch (error) {
            console.warn('No se pudo recuperar el checklist guardado.', error);
        }

        updateProgress();
    }

    function resetChecklist() {
        localStorage.removeItem(STORAGE_KEY);
        document.querySelectorAll('.check-card input[type="checkbox"]')
            .forEach(cb => cb.checked = false);
        updateProgress();
    }

    // Marca automáticamente en el menú la sección visible.
    function setupActiveNavigation() {
        const links = [...document.querySelectorAll('nav.menu a[href^="#"]')];
        const sections = links
            .map(link => document.querySelector(link.getAttribute('href')))
            .filter(Boolean);

        const observer = new IntersectionObserver((entries) => {
            const visible = entries
                .filter(entry => entry.isIntersecting)
                .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

            if (!visible) return;

            links.forEach(link => {
                link.classList.toggle(
                    'active',
                    link.getAttribute('href') === '#' + visible.target.id
                );
            });
        }, {
            rootMargin: '-12% 0px -72% 0px',
            threshold: [0, .15, .35, .6]
        });

        sections.forEach(section => observer.observe(section));
    }

    window.addEventListener('DOMContentLoaded', () => {
        loadProgress();
        setupActiveNavigation();
    });
</script>

